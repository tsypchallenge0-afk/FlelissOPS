# Copy to .env and adjust.

# MongoDB started by docker-compose (user/password from docker-compose.yml).
# [::1] reaches Docker's port forward directly. On Windows a local "MongoDB" service can
# also listen on 127.0.0.1:27017 and would win there; [::1] avoids it and does not
# depend on your LAN IP. (127.0.0.1 works too when no local MongoDB is installed.)
MONGO_URL=mongodb://admin:password@[::1]:27017/?authSource=admin
DATABASE_NAME=poultry_db

# Sign JWTs with a long random value in any shared/deployed environment.
JWT_SECRET=change-me-to-a-long-random-string

# Optional — e-mail for scheduled reports and user invitations
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
