# Copy to .env.
# The app picks the tenant from the sub-domain: <tenant>.lvh.me → tenant, super.lvh.me → super admin.
# *.lvh.me resolves to 127.0.0.1 via public DNS; for offline use add hosts-file entries (see README).
VITE_BASE_DOMAIN=lvh.me
VITE_SUPER_ADMIN_DOMAIN=super.lvh.me

# Optional: call the API directly instead of through the Vite /api proxy
# VITE_API_BASE_URL=http://127.0.0.1:9000
